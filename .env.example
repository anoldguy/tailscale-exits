# TSE Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then either:
#   - Use direnv: echo 'dotenv' > .envrc && direnv allow
#   - Source manually: source .env
#   - Export individually: export TAILSCALE_API_TOKEN=...

# Tailscale API token (required for setup command only)
# Used to configure your Tailscale account (ACL tagOwners + autoApprovers).
# Caps at 90 days and cannot be renewed, but setup is a one-time command, so
# mint one the morning you need it and let it expire afterward.
# Create at: https://login.tailscale.com/admin/settings/keys
# Must be Owner or Admin role
TAILSCALE_API_TOKEN=tskey-api-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Tailscale OAuth client secret (required for deploy command)
# Create at: https://login.tailscale.com/admin/settings/oauth
# Requirements: auth_keys scope (write), tagged with tag:exitnode
# Unlike auth keys, this does not expire. Tailscale mints a fresh single-use
# key from it each time a node registers.
TAILSCALE_OAUTH_SECRET=tskey-client-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# TSE auth token (generated by deploy, save it!)
# This is used to authenticate requests to the Lambda function
# First run of 'tse deploy' will generate this - copy and save it here
# Or create your own, and it will be used instead of a generated one
TSE_AUTH_TOKEN=

# Lambda function URL (set after deploy)
# Exported by 'tse deploy' - copy and save it here
TSE_LAMBDA_URL=
